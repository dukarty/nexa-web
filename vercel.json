{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/descargar",
      "destination": "/descarga",
      "permanent": true
    },
    {
      "source": "/soporte",
      "destination": "/ayuda",
      "permanent": true
    },
    {
      "source": "/panel",
      "destination": "/empresas/panel/",
      "permanent": true
    },
    {
      "source": "/panel-v3",
      "destination": "/empresas/panel/",
      "permanent": true
    },
    {
      "source": "/momentos",
      "destination": "/nyxas",
      "permanent": true
    },
    {
      "source": "/manifiesto",
      "destination": "/producto",
      "permanent": true
    },
    {
      "source": "/normas",
      "destination": "/seguridad",
      "permanent": true
    },
    {
      "source": "/ciudades",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}